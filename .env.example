# Copy this file to .env and fill in real values. NEVER commit .env.
# cp .env.example .env

# Local LLM (Ollama runs on Windows, WSL reaches it via localhost - mirrored networking)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Demo app database (used from Phase 2)
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shop

# Observability (profile "obs", from Phase 3). Grafana is read-only for anonymous
# visitors; this password is only needed to edit dashboards.
# Generate a random one:  echo "GRAFANA_ADMIN_PASSWORD=$(openssl rand -hex 12)" >> .env
GRAFANA_ADMIN_PASSWORD=change-me-too
LOADGEN_RPS=2
