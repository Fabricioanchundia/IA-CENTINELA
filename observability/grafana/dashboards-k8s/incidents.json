        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "MTTD (avg)",
      "description": "Mean Time To Detect: fault starts (alert condition true) -> Centinela records it.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidents"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "incidents"
          },
          "rawSql": "SELECT avg(mttd_seconds) AS mttd FROM incident_metrics WHERE $__timeFilter(detected_at)",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 120
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "MTTR (avg)",
      "description": "Mean Time To Resolve: detection -> every alert of the incident has cleared.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidents"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "incidents"
          },
          "rawSql": "SELECT avg(mttr_seconds) AS mttr FROM incident_metrics WHERE $__timeFilter(detected_at) AND status = 'resolved'",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 600
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Critical incidents",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidents"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "incidents"
          },
          "rawSql": "SELECT count(*) AS critical FROM incidents WHERE $__timeFilter(detected_at) AND severity = 'critical'",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "With postmortem",
      "description": "Resolved incidents with a recorded root cause and resolution.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidents"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "incidents"
          },
          "rawSql": "SELECT count(*) FILTER (WHERE root_cause IS NOT NULL) * 100.0 / NULLIF(count(*), 0) AS pct FROM incidents WHERE $__timeFilter(detected_at) AND status = 'resolved'",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Incidents by category",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidents"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "incidents"
          },
          "rawSql": "SELECT category, count(*) AS incidents FROM incidents WHERE $__timeFilter(detected_at) GROUP BY category ORDER BY incidents DESC",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "MTTD vs MTTR by category (avg, s)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidents"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "incidents"
          },
          "rawSql": "SELECT category, round(avg(mttd_seconds)) AS mttd, round(avg(mttr_seconds)) AS mttr FROM incident_metrics WHERE $__timeFilter(detected_at) GROUP BY category ORDER BY category",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Recent incidents",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidents"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "incidents"
          },
          "rawSql": "SELECT id, detected_at AS detected, status, severity, category, service, title, round(mttd_seconds) AS mttd_s, round(mttr_seconds) AS mttr_s, root_cause FROM incident_metrics WHERE $__timeFilter(detected_at) ORDER BY id DESC LIMIT 50",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "open": {
                        "color": "red",
                        "index": 0
                      },
                      "resolved": {
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mttd_s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mttr_s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
