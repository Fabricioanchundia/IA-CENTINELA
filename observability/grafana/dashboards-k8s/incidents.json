      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "incidents"
          },
          "rawSql": "SELECT count(*) AS incidents FROM incidents WHERE $__timeFilter(detected_at)",
          "format": "table",
          "editorMode": "code",
