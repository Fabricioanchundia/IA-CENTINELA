{
  "uid": "centinela-incidents",
  "title": "Centinela · Incidents",
  "description": "Incident history recorded by the collector: MTTD, MTTR and postmortems.",
  "tags": [
    "centinela",
    "sre",
    "incidents"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
